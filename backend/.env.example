# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Google Gemini key for the doctor AI summary and the patient chatbot
# (free key: https://aistudio.google.com/apikey). Free tier: demo data only.
GEMINI_API_KEY=

# Optional overrides
# MEDIS_LLM_MODEL=gemini-3.8-flash
# SUPABASE_URL=            (defaults to VITE_SUPABASE_URL in frontend/.env)
# SUPABASE_ANON_KEY=       (defaults to VITE_SUPABASE_ANON_KEY in frontend/.env)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   (default)
